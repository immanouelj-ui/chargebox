<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" fill="none">
  <defs>
    <linearGradient id="wallbox-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1E293B" />
      <stop offset="100%" stop-color="#0F172A" />
    </linearGradient>
    <linearGradient id="halo-green" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00C48C" />
      <stop offset="100%" stop-color="#00E5A3" />
    </linearGradient>
  </defs>
  <rect width="400" height="400" fill="#F8FAFC" rx="16" />
  <ellipse cx="200" cy="340" rx="70" ry="10" fill="#000" opacity="0.1" />
  <!-- Compact Square Body with Rounded Corners -->
  <rect x="110" y="90" width="180" height="200" rx="36" fill="url(#wallbox-grad)" stroke="#334155" stroke-width="2" />
  <!-- Iconic Wallbox LED Halo Ring -->
  <circle cx="200" cy="180" r="46" stroke="url(#halo-green)" stroke-width="6" fill="none" opacity="0.95" />
  <text x="200" y="245" font-family="system-ui, sans-serif" font-weight="800" font-size="12" fill="#FFFFFF" text-anchor="middle" letter-spacing="-0.5">wallbox</text>
  <!-- Attached cable outlet at bottom -->
  <rect x="185" y="280" width="30" height="25" rx="8" fill="#334155" />
</svg>
