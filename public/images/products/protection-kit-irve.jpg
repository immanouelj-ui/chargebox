<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" fill="none">
  <rect width="400" height="400" fill="#F8FAFC" rx="16" />
  <ellipse cx="200" cy="340" rx="90" ry="12" fill="#000" opacity="0.1" />
  <!-- Modular Electrical Box -->
  <rect x="90" y="80" width="220" height="230" rx="12" fill="#FFFFFF" stroke="#94A3B8" stroke-width="3" />
  <rect x="105" y="95" width="190" height="70" rx="6" fill="#E2E8F0" stroke="#CBD5E1" stroke-width="2" />
  
  <!-- DIN Rail Modules: Differential Type A-EV & Circuit Breaker -->
  <g transform="translate(120, 105)">
    <!-- Diff -->
    <rect x="0" y="0" width="70" height="50" rx="4" fill="#0F172A" />
    <rect x="15" y="10" width="40" height="8" rx="2" fill="#00D26A" />
    <text x="35" y="38" font-family="sans-serif" font-weight="700" font-size="8" fill="#FFF" text-anchor="middle">30mA DIFF</text>
    
    <!-- Disjoncteur -->
    <rect x="80" y="0" width="45" height="50" rx="4" fill="#1E293B" />
    <rect x="92" y="10" width="20" height="8" rx="2" fill="#38BDF8" />
    <text x="102" y="38" font-family="sans-serif" font-weight="700" font-size="8" fill="#FFF" text-anchor="middle">40A</text>
    
    <!-- Bobine MX -->
    <rect x="135" y="0" width="25" height="50" rx="4" fill="#334155" />
  </g>
  
  <text x="200" y="210" font-family="system-ui, sans-serif" font-weight="800" font-size="14" fill="#0F172A" text-anchor="middle">KIT DE PROTECTION IRVE</text>
  <text x="200" y="230" font-family="system-ui, sans-serif" font-weight="600" font-size="11" fill="#475569" text-anchor="middle">Différentiel 30mA Type F/A-EV + Disjoncteur 40A</text>
  
  <!-- Norm badge -->
  <rect x="130" y="255" width="140" height="28" rx="6" fill="#00D26A" fill-opacity="0.15" stroke="#00D26A" stroke-width="1" />
  <text x="200" y="274" font-family="system-ui, sans-serif" font-weight="700" font-size="10" fill="#097a42" text-anchor="middle">CONFORME NF C 15-100</text>
</svg>
