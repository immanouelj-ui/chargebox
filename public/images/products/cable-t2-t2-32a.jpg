<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" fill="none">
  <rect width="400" height="400" fill="#F8FAFC" rx="16" />
  <ellipse cx="200" cy="330" rx="90" ry="12" fill="#000" opacity="0.1" />
  <!-- Coiled Heavy Duty EV Cable -->
  <circle cx="200" cy="200" r="100" stroke="#0F172A" stroke-width="20" fill="none" />
  <circle cx="200" cy="200" r="80" stroke="#1E293B" stroke-width="16" fill="none" />
  <!-- T2 Plug 1 -->
  <rect x="130" y="100" width="40" height="70" rx="10" fill="#00D26A" transform="rotate(-30 130 100)" />
  <!-- T2 Plug 2 -->
  <rect x="230" y="240" width="40" height="70" rx="10" fill="#00D26A" transform="rotate(45 230 240)" />
  <text x="200" y="205" font-family="system-ui, sans-serif" font-weight="700" font-size="14" fill="#0F172A" text-anchor="middle">TYPE 2 · 32A · 22 kW</text>
  <text x="200" y="225" font-family="system-ui, sans-serif" font-weight="600" font-size="11" fill="#00D26A" text-anchor="middle">5 MÈTRES TRIPHASÉ</text>
</svg>
