<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" fill="none">
  <defs>
    <linearGradient id="wood-front" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#3E2723" />
      <stop offset="100%" stop-color="#271815" />
    </linearGradient>
    <linearGradient id="telto-case" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1E293B" />
      <stop offset="100%" stop-color="#0F172A" />
    </linearGradient>
    <linearGradient id="led-glow" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#00D26A" />
      <stop offset="100%" stop-color="#06B6D4" />
    </linearGradient>
  </defs>
  
  <rect width="400" height="400" fill="#F8FAFC" rx="16" />
  
  <!-- Shadow -->
  <ellipse cx="200" cy="355" rx="80" ry="12" fill="#000" opacity="0.12" />
  
  <!-- Outer Body -->
  <rect x="130" y="70" width="140" height="260" rx="28" fill="url(#telto-case)" stroke="#334155" stroke-width="3" />
  
  <!-- Premium Front Plate (Dark Wood / Obsidian Edition) -->
  <rect x="142" y="82" width="116" height="236" rx="20" fill="url(#wood-front)" />
  
  <!-- Dynamic LED Status Bar -->
  <rect x="160" y="115" width="80" height="6" rx="3" fill="url(#led-glow)" />
  
  <!-- RFID Area -->
  <circle cx="200" cy="165" r="16" stroke="#475569" stroke-width="1.5" stroke-dasharray="3 3" />
  <path d="M195 160C198 158 202 158 205 160M192 165C197 162 203 162 208 165M190 170C196 166 204 166 210 170" stroke="#00D26A" stroke-width="2" stroke-linecap="round" />
  
  <!-- Type 2 Socket with protective cover -->
  <circle cx="200" cy="240" r="34" fill="#0F172A" stroke="#475569" stroke-width="2" />
  <circle cx="200" cy="240" r="28" fill="#1E293B" />
  <!-- Pin holes -->
  <circle cx="188" cy="232" r="4.5" fill="#334155" />
  <circle cx="212" cy="232" r="4.5" fill="#334155" />
  <circle cx="188" cy="248" r="4.5" fill="#334155" />
  <circle cx="212" cy="248" r="4.5" fill="#334155" />
  <circle cx="200" cy="225" r="3" fill="#334155" />
  <circle cx="200" cy="255" r="3" fill="#334155" />
  
  <!-- Teltonika Logo on base -->
  <text x="200" y="300" font-family="system-ui, sans-serif" font-weight="700" font-size="8" fill="#94A3B8" text-anchor="middle" letter-spacing="1.5">TELTONIKA</text>
</svg>
